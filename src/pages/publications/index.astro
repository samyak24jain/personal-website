---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { PUBLICATIONS } from "@consts";
import { PUBLICATIONS_LIST, SCHOLAR_URL } from "@data/publications";

const papers = PUBLICATIONS_LIST.filter((p) => p.type === "paper");
const patents = PUBLICATIONS_LIST.filter((p) => p.type === "patent");

const groups = [
  { heading: "Papers", items: papers },
  { heading: "Patents", items: patents },
].filter((g) => g.items.length > 0);
---

<PageLayout title={PUBLICATIONS.TITLE} description={PUBLICATIONS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate flex flex-wrap items-center justify-between gap-2">
        <div class="font-semibold text-black dark:text-white">
          Publications
        </div>
        <Link href={SCHOLAR_URL} external>
          Google Scholar
        </Link>
      </div>

      <div class="space-y-10">
        {groups.map((group) => (
          <section class="animate space-y-4">
            <div class="font-semibold text-black dark:text-white">
              {group.heading}
            </div>
            <ul class="flex flex-col space-y-4">
              {group.items.map((pub) => (
                <li>
                  <div class="font-semibold text-black dark:text-white">
                    {pub.link ? (
                      <Link href={pub.link} external>
                        {pub.title}
                      </Link>
                    ) : (
                      pub.title
                    )}
                  </div>
                  <div class="text-sm opacity-75">
                    {pub.venue} · {pub.year}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </Container>
</PageLayout>
